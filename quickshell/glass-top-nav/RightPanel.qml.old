import QtQuick
import Quickshell
import Quickshell.Io
import qs.config

import qs.rightPanel as RP

Row {
    id: root
    spacing: 6

    // ---- mic toggle ---------------------------------------------------
    GlassNavButton {
        id: micButton
        property bool muted: muteCollector.text.trim() === "1"

        icon: muted ? ` ` : ``   // paste your glyphs
        textColor: Config.textColor
        padding: 8

        onClicked: micToggle.running = true
    }

    // ---- volume ---------------------------------------------------------
    RP.ThresholdButton {
        value: root.volume
        icons: [" ", " ", " ", " "]         // paste your glyphs

        onRightClicked: Quickshell.execDetached(["pwvucontrol"])
    }

    // ---- wifi -----------------------------------------------------------
    RP.ThresholdButton {
        value: root.wifiSignal
        icons: ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "]  // paste your glyphs

        width: 100
        onRightClicked: Quickshell.execDetached(["kitty", "-e", "nmtui"])

        Row {
            id: segments
            height: parent.height

            SegmentButton { icon: "󰖩"; onClicked: console.log("wifi") }
            SegmentButton { icon: "󰂯"; onClicked: console.log("bluetooth") }
        }
    }

    Bluetooth {}

    // ---- state + polling ------------------------------------------------
    property real volume: 0
    property real wifiSignal: 0

    Process {
        id: micToggle
        command: ["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"]
        onExited: muteQuery.running = true
    }
    Process {
        id: muteQuery
        command: ["sh", "-c",
            "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo 1 || echo 0"]
        stdout: StdioCollector { id: muteCollector }
    }

    Process {
        id: audioQuery
        command: ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]
        stdout: StdioCollector {
            onStreamFinished: {
                const m = text.match(/([0-9.]+)/)
                root.volume = m ? parseFloat(m[1]) * 100 : 0
            }
        }
    }

    Process {
        id: wifiQuery
        command: ["sh", "-c",
            "nmcli -t -f IN-USE,SSID,SIGNAL dev wifi list | grep '^\\*'"]
        stdout: StdioCollector {
            onStreamFinished: {
                const parts = text.trim().split(":")
                root.wifiSignal = parts.length > 2 ? parseFloat(parts[2]) : 0
            }
        }
    }

    Timer {
        interval: 1000
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: {
            muteQuery.running = true
            audioQuery.running = true
            wifiQuery.running = true
        }
    }
}
